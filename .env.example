# Variables de docker-compose. Todas tienen valor por defecto en el compose:
# copiar a .env solo si se quiere cambiar alguna.

GATEWAY_PORT=8080

APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8080

DB_DATABASE=incidents
DB_USERNAME=incidents
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

RUN_MIGRATIONS=true
SEED_INCIDENTS=5000

REVERB_APP_ID=psicol
REVERB_APP_KEY=psicol-key
REVERB_APP_SECRET=psicol-secret
